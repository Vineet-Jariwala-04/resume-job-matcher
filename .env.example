# Copy this file to ".env" (same folder as app.py) and fill in the values.
# 1. Turn on 2-Step Verification for the sending Gmail account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
#    (use the 16-character app password, NOT your normal Gmail password).
GMAIL_ADDRESS=your.sending.account@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Set to false to turn all emails off without removing the setup.
EMAIL_ENABLED=true
# What to email at logout when NO match analysis was done during that login:
#   first_time = send "no analysis done" only on the very first logout, then stay silent (default)
#   always     = send it every time
#   never      = never send it
# (An analysis done during the login is always emailed with its PDF.)
NO_ANALYSIS_EMAIL=always

# Email verification code at signup (true = required, false = skip it).
SIGNUP_OTP=true

# Optional: your own long random secret for login sessions. If empty, the app creates one automatically (.flask_secret_key).
# FLASK_SECRET_KEY=

# AI model used for analysis and resume polishing. The default is small and fast; a bigger one writes better
# summaries (run `ollama pull qwen2.5:3b` first, then uncomment):
# OLLAMA_MODEL=qwen2.5:3b
